# Copy to .env.local (or set these in your host's dashboard).

# Your deployed address, no trailing slash. Enables sitemap.xml, canonical and og:url tags.
VITE_SITE_URL=

# Form endpoint that accepts a JSON POST (e.g. https://formspree.io/f/xxxxxxx).
# Leave empty to keep the "open email app" fallback.
VITE_FORM_ENDPOINT=
